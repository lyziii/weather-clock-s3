# S3R8 使用外部 16 MB QSPI Flash 和封装内 8 MB Octal PSRAM。
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y

# GPS 占用 GPIO43/44，应用控制台使用原生 USB Serial/JTAG。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# 21169 个字形的点阵索引超过 20 位（1 MB），必须使用 32 位描述符
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# TLS 握手缓冲放到 PSRAM，避免字库/WiFi 占用内部 RAM 后 mbedTLS 分配失败。
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_LV_USE_CLIB_MALLOC=y
# 中文字库常驻 Flash 的 font 分区，按地址交给 MEMFS 解析，不需要文件系统。
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# TF 文件浏览使用长文件名和 UTF-8；仅挂载已有 FAT 文件系统，不自动格式化。
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# 启用 TinyUSB MSC，把 TF 卡作为 U 盘暴露给电脑（用于拷贝字库等文件）。
CONFIG_TINYUSB_MSC_ENABLED=y
